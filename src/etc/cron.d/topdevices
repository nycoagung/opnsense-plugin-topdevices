# TopDevices: keeps NetFlow's rotated flow log for two days, samples the WireGuard
# tunnel counters every minute, and every minute notes which devices are connected,
# for the Connected devices widget (installed by install.sh)
SHELL=/bin/sh
*/10	*	*	*	*	root	/usr/local/opnsense/scripts/topdevices/keep.py >/dev/null 2>&1
*	*	*	*	*	root	/usr/local/opnsense/scripts/topdevices/tunnels.py >/dev/null 2>&1
*	*	*	*	*	root	/usr/local/opnsense/scripts/topdevices/connected.py track >/dev/null 2>&1
